<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rubye_bg_claro">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="90dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Imagem de topo enorme -->
            <ImageView
                android:id="@+id/ivFotoDetalhe"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:scaleType="centerCrop"
                android:background="@color/rubye_light_gray" />

            <!-- Container das informações de texto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="370dp"
                android:background="@drawable/bg_bottom_sheet_rounded"
                android:padding="32dp">

                <TextView
                    android:id="@+id/tvNomeDetalhe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nome do Sofá"
                    android:textColor="@color/rubye_header"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPrecoDetalhe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="R$ 0,00"
                    android:textColor="@color/rubye_gold"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Linha divisória minimalista -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/rubye_sand"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sobre o produto"
                    android:textColor="@color/rubye_fonte_escura"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvDescricaoDetalhe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Este estofado de alto padrão conta com acabamento premium e design exclusivo. As descrições reais serão alimentadas pelo painel administrativo em breve."
                    android:textColor="#666666"
                    android:textSize="15sp"
                    android:lineSpacingExtra="6dp" />

            </LinearLayout>
        </RelativeLayout>
    </ScrollView>

    <!-- Botões Flutuantes sobre a Imagem (Estilo Instagram/Revista) -->
    <ImageView
        android:id="@+id/btnVoltar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_circle_icon"
        android:src="@drawable/ic_back"
        android:padding="10dp"
        app:tint="@color/rubye_header" />

    <ImageView
        android:id="@+id/btnIrCarrinho"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_circle_icon"
        android:src="@drawable/ic_cart"
        android:padding="10dp"
        app:tint="@color/rubye_header" />

    <!-- Barra Inferior Fixa com Botão de Comprar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:padding="16dp"
        android:elevation="16dp">

        <Button
            android:id="@+id/btnComprar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Adicionar ao Carrinho"
            android:textColor="@color/rubye_gold"
            android:backgroundTint="@color/rubye_header"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>