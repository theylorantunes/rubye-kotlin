<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rubye_bg_claro"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <TextView
            android:id="@+id/tvVoltar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/rubye_header"
            android:padding="16dp"
            android:text="&lt; VOLTAR AO CATÁLOGO"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"/>


        <ImageView
            android:id="@+id/ivFotoDetalhe"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:scaleType="centerCrop"
            android:background="@color/rubye_light_gray" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvNomeDetalhe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome do Sofá"
                android:textColor="@color/rubye_fonte_escura"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDescricaoDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Descrição provisória do produto. Este estofado de alto padrão conta com acabamento premium e design exclusivo. As descrições reais serão alimentadas pelo painel administrativo em breve."
                android:textColor="#555555"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/tvPrecoDetalhe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="R$ 0,00"
                android:textColor="@color/black"
                android:textSize="32sp"
                android:textStyle="bold" />


            <Button
                android:id="@+id/btnComprar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="@color/rubye_header"
                android:text="COMPRAR"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="4dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>