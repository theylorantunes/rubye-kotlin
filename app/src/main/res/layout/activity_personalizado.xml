<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rubye_bg_claro"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/estofado_personalizado"
            android:textColor="@color/rubye_header"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:textAlignment="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/desc_personalizado"
            android:textColor="#555555"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"
            android:textAlignment="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tamanho"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>
        <Spinner
            android:id="@+id/spTamanho"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_checkout"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/estilo"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>
        <Spinner
            android:id="@+id/spEstilo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_checkout"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/material_tecido"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>
        <Spinner
            android:id="@+id/spMaterial"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_checkout"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/madeira_base"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>
        <Spinner
            android:id="@+id/spMadeira"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_checkout"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detalhes_adicionais"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>
        <EditText
            android:id="@+id/etDetalhes"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/bg_input_checkout"
            android:hint="@string/hint_detalhes"
            android:padding="12dp"
            android:gravity="top|start"
            android:textColorHint="#757575"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:inputType="textMultiLine"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnSolicitarOrcamento"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="@color/rubye_gold"
            android:text="@string/solicitar_orcamento"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnVoltarCatalogoPers"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@android:color/transparent"
            android:text="@string/voltar_catalogo"
            android:textColor="@color/rubye_header"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:elevation="0dp"
            app:cornerRadius="8dp" />

    </LinearLayout>
    </ScrollView>

    <!-- Navegação Inferior -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rubye_header"
        app:itemIconTint="@color/bottom_nav_colors"
        app:itemTextColor="@color/bottom_nav_colors"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
