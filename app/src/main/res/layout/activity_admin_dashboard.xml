<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rubye_bg_claro"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rubye_header"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnVoltarAdmin"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            app:tint="@color/white"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/app_name"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Painel Administrativo"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rubye Estofados"
                android:textColor="@color/rubye_gold"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/logo_rubye"
            app:tint="@color/white"
            android:contentDescription="@string/app_name"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_input_checkout"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5"
                        android:textColor="@color/rubye_header"
                        android:textSize="28sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pedidos\nPendentes"
                        android:textColor="#555555"
                        android:textSize="12sp"
                        android:textAlignment="center"/>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#DDDDDD"
                    android:layout_marginHorizontal="16dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R$ 12k"
                        android:textColor="@color/rubye_gold"
                        android:textSize="28sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vendas\nno Mês"
                        android:textColor="#555555"
                        android:textSize="12sp"
                        android:textAlignment="center"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ferramentas"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnAdminProdutos"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="@color/white"
                android:textColor="@color/rubye_header"
                app:strokeColor="@color/rubye_header"
                app:strokeWidth="1dp"
                android:text="📦 Gerenciar Catálogo"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnAdminPedidos"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="@color/white"
                android:textColor="@color/rubye_header"
                app:strokeColor="@color/rubye_header"
                app:strokeWidth="1dp"
                android:text="📋 Fila de Pedidos"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnAdminLeiloes"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="@color/white"
                android:textColor="@color/rubye_header"
                app:strokeColor="@color/rubye_header"
                app:strokeWidth="1dp"
                android:text="🔨 Moderação de Leilões"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>