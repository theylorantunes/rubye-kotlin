<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rubye_bg_claro">

    <!-- Imagem de fundo para chamar a atenção (com opacidade para não atrapalhar leitura) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/sofa_renan"
        android:alpha="0.2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:src="@drawable/logo_rubye"
            android:adjustViewBounds="true"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BEM-VINDO"
            android:textColor="@color/rubye_header"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estofados de alto padrão que transformam o seu ambiente."
            android:textColor="@color/rubye_fonte_escura"
            android:textSize="16sp"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- Botões na parte inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:padding="24dp">

        <!-- Botão de Login (Destaque) -->
        <Button
            android:id="@+id/btnFazerLogin"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Fazer Login"
            android:textColor="@color/rubye_gold"
            android:backgroundTint="@color/rubye_header"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Botão de Cadastro (Secundário) -->
        <Button
            android:id="@+id/btnCriarConta"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Criar minha conta"
            android:textColor="@color/rubye_header"
            android:backgroundTint="@color/rubye_sand"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>