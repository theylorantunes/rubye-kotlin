<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rubye_bg_claro"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <LinearLayout
        android:id="@+id/llLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:src="@drawable/logo_rubye"
            android:adjustViewBounds="true"
            app:tint="@color/rubye_header"
            android:layout_marginBottom="32dp"
            android:contentDescription="@string/app_name" />

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/rubye_header"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvStatusPagamento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carregando checkout seguro..."
            android:textColor="#555555"
            android:textSize="16sp"
            android:textStyle="italic" />
    </LinearLayout>

    <WebView
        android:id="@+id/webViewAbacate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</LinearLayout>
